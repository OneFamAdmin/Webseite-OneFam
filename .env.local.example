# OneFam — environment variables.
# Copy this file to ".env.local" and fill in the values. NEVER commit .env.local.

# Supabase  (Project Settings → API). Choose the EU/Frankfurt region for DSG.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — admin writes (pool amount, draws). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Draw randomness (drand). Public League-of-Entropy mainnet by default.
DRAND_CHAIN_URL=https://api.drand.sh

# E-mail address that gets /admin access (must match a logged-in user).
ADMIN_EMAIL=

# E-mail sending (Resend — https://resend.com). Create a free account + API key.
RESEND_API_KEY=
# Sender. Until you verify onefam.ch in Resend, the test sender below only
# delivers to your OWN Resend account e-mail. After verifying the domain use e.g.:
#   EMAIL_FROM=OneFam <info@onefam.ch>
EMAIL_FROM=OneFam <onboarding@resend.dev>
# Public site URL used in e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WooCommerce (shop.onefam.ch) — Kaeufer-Erkennung + Pool.
#
# 1) REST-API zum LESEN: WP-Admin -> WooCommerce -> Einstellungen -> Erweitert ->
#    REST-API -> Schluessel hinzufuegen, Berechtigung "Lesen".
WOO_API_URL=https://shop.onefam.ch
WOO_KEY=
WOO_SECRET=
#
# 2) Webhook zum EMPFANGEN: WP-Admin -> WooCommerce -> Einstellungen -> Erweitert ->
#    Webhooks -> Webhook hinzufuegen. Thema "Bestellung aktualisiert", Lieferadresse
#    https://<deine-domain>/api/woo/webhook, dann das dort gesetzte Geheimnis hier
#    eintragen. Den AKTIVEN PodOS-Webhook dabei nicht anfassen.
WOO_WEBHOOK_SECRET=

# PodOS / ShirtKing — production-cost (COGS) source for the pool accounting (P2).
# PROJECT name is in your PodOS URL (?project=…). API key: PodOS → Settings → Developer.
PODOS_API_BASE=https://api.podos.io/v1
PODOS_PROJECT=onefam-441595
PODOS_API_KEY=
